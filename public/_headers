# Workers Static Assets reads this from out/. HTML keeps the default
# (public, max-age=0, must-revalidate), so a deploy shows up at once.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# next/og writes the share image and the apple-touch icon with no file
# extension, so nothing would name their type, and nosniff would leave a
# crawler or iOS to refuse them.
/opengraph-image
  Content-Type: image/png

/apple-icon
  Content-Type: image/png

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
