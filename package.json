{
  "name": "thesamegatsby",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.ts\"",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "cf:dev": "next build && wrangler dev",
    "add-song": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/add-song.ts",
    "check-media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-media.ts",
    "export-design-system": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/design-system-export.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "wrangler": "4.153.0"
  }
}
